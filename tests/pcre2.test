# match builtin
# jq's external flags keep their meaning independently of PCRE2 option names.
[test("a.b"; ("m", "p", "ms", "sm"))]
"a\nb"
[true,true,true,true]

[test("b"; ("s", "p", "ms", "sm"))]
"a\nb"
[true,true,true,true]

test("^b$"; "m")
"a\nb"
false

# Explicit inline multiline mode remains available with external s.
test("(?m)^b$"; "s")
"a\nb"
true

[match("( )*"; "g")]
"abc"
[{"offset":0,"length":0,"string":"","captures":[{"offset":-1,"string":null,"length":0,"name":null}]},{"offset":1,"length":0,"string":"","captures":[{"offset":-1,"string":null,"length":0,"name":null}]},{"offset":2,"length":0,"string":"","captures":[{"offset":-1,"string":null,"length":0,"name":null}]},{"offset":3,"length":0,"string":"","captures":[{"offset":-1,"string":null,"length":0,"name":null}]}]

[match("( )*"; "gn")]
"abc"
[]

[match(""; "g")]
"ab"
[{"offset":0,"length":0,"string":"","captures":[]},{"offset":1,"length":0,"string":"","captures":[]},{"offset":2,"length":0,"string":"","captures":[]}]

# Empty global matches advance past the current codepoint.
[match("a*|b"; "g") | {offset, length, string}]
"b"
[{"offset":0,"length":0,"string":""},{"offset":1,"length":0,"string":""}]

[match("a*|b"; "g") | {offset, length, string}]
"bc"
[{"offset":0,"length":0,"string":""},{"offset":1,"length":0,"string":""},{"offset":2,"length":0,"string":""}]

[match("|."; "g") | {offset, length, string}]
"🚀"
[{"offset":0,"length":0,"string":""},{"offset":1,"length":0,"string":""}]

# global zero-width matches must not land inside a multibyte character
[match(""; "g") | .offset]
"aé€🚀b"
[0,1,2,3,4,5]

gsub(""; "-")
"aé"
"-a-é-"

[splits("")]
"aé"
["","a","é",""]

[match("a"; "gi")]
"āáàä"
[]

[match(["(bar)"])]
"foo bar"
[{"offset": 4, "length": 3, "string": "bar", "captures":[{"offset": 4, "length": 3, "string": "bar", "name": null}]}]

# offsets account for combining codepoints and multi-byte UTF-8
[match("bar")]
"ā bar with a combining codepoint U+0304"
[{"offset": 3, "length": 3, "string": "bar", "captures":[]}]

# matches with combining codepoints still count them in their length
[match("bār")]
"a bār"
[{"offset": 2, "length": 4, "string": "bār", "captures":[]}]

# TODO: temp disabled as pcre2 < 10.43 captures length 1
#[match(".+?\\b")]
#"ā two-codepoint grapheme"
#[{"offset": 0, "length": 2, "string": "ā", "captures":[]}]

[match(["foo (?<bar123>bar)? foo", "ig"])]
"foo bar foo foo  foo"
[{"offset": 0, "length": 11, "string": "foo bar foo", "captures":[{"offset": 4, "length": 3, "string": "bar", "name": "bar123"}]},{"offset":12, "length": 8, "string": "foo  foo", "captures":[{"offset": -1, "length": 0, "string": null, "name": "bar123"}]}]

# non-matched optional group
"a","b","c" | capture("(?<x>a)?b?")
null
{"x":"a"}
{"x":null}
{"x":null}

"a","b","c" | match("(?<x>a)?b?")
null
{"offset":0,"length":1,"string":"a","captures":[{"offset":0,"length":1,"string":"a","name":"x"}]}
{"offset":0,"length":1,"string":"b","captures":[{"offset":-1,"string":null,"length":0,"name":"x"}]}
{"offset":0,"length":0,"string":"","captures":[{"offset":-1,"string":null,"length":0,"name":"x"}]}

# same as above but allow empty match for group
"a","b","c" | capture("(?<x>a?)?b?")
null
{"x":"a"}
{"x":""}
{"x":""}

"a","b","c" | match("(?<x>a?)?b?")
null
{"offset":0,"length":1,"string":"a","captures":[{"offset":0,"length":1,"string":"a","name":"x"}]}
{"offset":0,"length":1,"string":"b","captures":[{"offset":0,"string":"","length":0,"name":"x"}]}
{"offset":0,"length":0,"string":"","captures":[{"offset":0,"string":"","length":0,"name":"x"}]}

# Captures in lookbehind start before the overall match.
[match("(?<=(a))b"; "")]
"ab"
[{"offset":1,"length":1,"string":"b","captures":[{"offset":0,"length":1,"string":"a","name":null}]}]

[match("(?<=(\u00e9\ud83d\ude80))Z"; "")]
"aé🚀Z"
[{"offset":3,"length":1,"string":"Z","captures":[{"offset":1,"length":2,"string":"é🚀","name":null}]}]

[match("(?<=(a))b"; "g")]
"abab"
[{"offset":1,"length":1,"string":"b","captures":[{"offset":0,"length":1,"string":"a","name":null}]},{"offset":3,"length":1,"string":"b","captures":[{"offset":2,"length":1,"string":"a","name":null}]}]

[match("(?<=(a))"; "")]
"ab"
[{"offset":1,"length":0,"string":"","captures":[{"offset":0,"length":1,"string":"a","name":null}]}]

#test builtin
[test("( )*"; "gn")]
"abc"
[false]

[test("ā")]
"ā"
[true]

capture("(?<a>[a-z]+)-(?<n>[0-9]+)")
"xyzzy-14"
{"a":"xyzzy","n":"14"}


# jq-coded utilities built on match:
#
# The second element in these tests' inputs tests the case where the
# fromstring matches both the head and tail of the string
[.[] | sub(", "; ":")]
["a,b, c, d, e,f", ", a,b, c, d, e,f, "]
["a,b:c, d, e,f",":a,b, c, d, e,f, "]

sub("^(?<head>.)"; "Head=\(.head) Tail=")
"abcdef"
"Head=a Tail=bcdef"

[.[] | gsub(", "; ":")]
["a,b, c, d, e,f",", a,b, c, d, e,f, "]
["a,b:c:d:e,f",":a,b:c:d:e,f:"]

gsub("(?<d>\\d)"; ":\(.d);")
"a1b2"
"a:1;b:2;"

gsub("a";"b")
"aaaaa"
"bbbbb"

gsub("(.*)"; ""; "x")
""
""

gsub(""; "a"; "g")
""
"a"

gsub("^"; ""; "g")
"a"
"a"

gsub(""; "a"; "g")
"a"
"aaa"

gsub("$"; "a"; "g")
"a"
"aa"

gsub("^"; "a")
""
"a"

gsub("(?=u)"; "u")
"qux"
"quux"

gsub("^.*a"; "b")
"aaa"
"b"

gsub("^.*?a"; "b")
"aaa"
"baa"

# The following is for regression testing and should not be construed as a requirement:
[gsub("a"; "b", "c")]
"a"
["b","c"]

[.[] | scan(", ")]
["a,b, c, d, e,f",", a,b, c, d, e,f, "]
[", ",", ",", ",", ",", ",", ",", ",", "]

[.[]|[[sub(", *";":")], [gsub(", *";":")], [scan(", *")]]]
["a,b, c, d, e,f",", a,b, c, d, e,f, "]
[[["a:b, c, d, e,f"],["a:b:c:d:e:f"],[",",", ",", ",", ",","]],[[":a,b, c, d, e,f, "],[":a:b:c:d:e:f:"],[", ",",",", ",", ",", ",",",", "]]]

[.[]|[[sub(", +";":")], [gsub(", +";":")], [scan(", +")]]]
["a,b, c, d, e,f",", a,b, c, d, e,f, "]
[[["a,b:c, d, e,f"],["a,b:c:d:e,f"],[", ",", ",", "]],[[":a,b, c, d, e,f, "],[":a,b:c:d:e,f:"],[", ",", ",", ",", ",", "]]]

[.[] | scan("b+"; "i")]
["","bBb","abcABBBCabbbc"]
["bBb","b","BBB","bbb"]

# reference to named captures
gsub("(?<x>.)[^a]*"; "+\(.x)-")
"Abcabc"
"+A-+a-"

gsub("(?<x>.)(?<y>[0-9])"; "\(.x|ascii_downcase)\(.y)")
"A1 B2 CD"
"a1 b2 CD"

gsub("\\b(?<x>.)"; "\(.x|ascii_downcase)")
"ABC DEF"
"aBC dEF"

gsub("[^a-z]*(?<x>[a-z]*)"; "Z\(.x)")
"123foo456bar"
"ZfooZbarZ"

# utf-8
sub("(?<x>.)"; "\(.x)!")
"’"
"’!"

[sub("a"; "b", "c")]
"a"
["b","c"]

[sub("(?<a>.)"; "\(.a|ascii_upcase)", "\(.a|ascii_downcase)", "c")]
"aB"
["AB","aB","cB"]

[gsub("(?<a>.)"; "\(.a|ascii_upcase)", "\(.a|ascii_downcase)", "c")]
"aB"
["AB","ab","cc"]

# splits
[splits("")]
"ab"
["","a","b",""]

[splits("c")]
"ab"
["ab"]

[splits("a+"; "i")]
"abAABBabA"
["","b","BB","b",""]

[splits("b+"; "i")]
"abAABBabA"
["a","AA","a","A"]

# subject type error test
try match("") catch .
null
"null (null) input cannot be matched, as it is not a string"

# pattern error test
try match("*") catch .
""
"regex failure: quantifier does not follow a repeatable item"

# modifiers type error test
try match(""; 123) catch .
""
"number (123) regex modifiers is not a string"

# null modifiers is ok with onig impl
test(""; null)
""
true

# multi-byte codepoint split
# different from onig (["","å","","ä","","ö","",""])
[splits("")]
"åäö"
["","å","ä","ö",""]

# dup group names (tested to be same as oni)
capture("(?<n>.)(?<n>.)").n
"ab"
"b"


# Empty-match iteration keeps jq's global search behavior.
# repeated-alternatives
[match("a*|b";"g") | {offset,length,string}]
"bb"
[{"offset":0,"length":0,"string":""},{"offset":1,"length":0,"string":""},{"offset":2,"length":0,"string":""}]

# nonempty-prefix
[match("a*|b";"g") | {offset,length,string}]
"aaab"
[{"offset":0,"length":3,"string":"aaa"},{"offset":3,"length":0,"string":""},{"offset":4,"length":0,"string":""}]

# two-byte
[match("|.";"g") | {offset,length,string}]
"é"
[{"offset":0,"length":0,"string":""},{"offset":1,"length":0,"string":""}]

# mixed-width
[match("|.";"g") | {offset,length,string}]
"é🚀Z"
[{"offset":0,"length":0,"string":""},{"offset":1,"length":0,"string":""},{"offset":2,"length":0,"string":""},{"offset":3,"length":0,"string":""}]

# combining-codepoints
[match("|.";"g") | {offset,length,string}]
"é"
[{"offset":0,"length":0,"string":""},{"offset":1,"length":0,"string":""},{"offset":2,"length":0,"string":""}]

# empty-subject
[match("a*|b";"g") | {offset,length,string}]
""
[{"offset":0,"length":0,"string":""}]

# nonempty-first-control
[match("b|a*";"g") | {offset,length,string}]
"b"
[{"offset":0,"length":1,"string":"b"},{"offset":1,"length":0,"string":""}]

# nonempty-global-control
[match("b+";"g") | {offset,length,string}]
"bb"
[{"offset":0,"length":2,"string":"bb"}]

# no-empty-control
[match("a*|b";"gn") | {offset,length,string}]
"bb"
[{"offset":0,"length":1,"string":"b"},{"offset":1,"length":1,"string":"b"}]

# non-global-control
[match("a*|b";"") | {offset,length,string}]
"b"
[{"offset":0,"length":0,"string":""}]

# start-anchor-alternative
[match("^|b";"g") | {offset,length,string}]
"b"
[{"offset":0,"length":0,"string":""}]

# lookahead-control
[match("(?=.)";"g") | {offset,length,string}]
"é🚀"
[{"offset":0,"length":0,"string":""},{"offset":1,"length":0,"string":""}]

# empty-pattern-control
[match("";"g") | {offset,length,string}]
"aé€🚀b"
[{"offset":0,"length":0,"string":""},{"offset":1,"length":0,"string":""},{"offset":2,"length":0,"string":""},{"offset":3,"length":0,"string":""},{"offset":4,"length":0,"string":""},{"offset":5,"length":0,"string":""}]

# gsub-alternative
gsub("|.";"X")
"b"
"XbX"

# scan-alternative
[scan("|.")]
"b"
["",""]

# splits-alternative
[splits("|.")]
"b"
["","b",""]

# gsub-mixed-width
gsub("|.";"X")
"é🚀"
"XéX🚀X"

# scan-empty-subject
[scan("|.")]
""
[""]

# final-newline-control
[match("$";"g") | {offset,length,string}]
"a\n"
[{"offset":1,"length":0,"string":""},{"offset":2,"length":0,"string":""}]

# search-finds-empty
[match("(?=b)|b";"g") | {offset,length,string}]
"ab"
[{"offset":1,"length":0,"string":""}]

# search-finds-utf8-empty
[match("(?=é)|é";"g") | {offset,length,string}]
"aéZ"
[{"offset":1,"length":0,"string":""}]
